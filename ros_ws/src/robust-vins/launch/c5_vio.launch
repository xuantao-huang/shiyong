<!-- YOPO C5 launch for far_vins (SchurVINS) + EKF attitude fusion
     Pipeline:
       far_vins  →  /far_vins/imu_propagate  (position only, zero quaternion, ~470Hz)
       ekf_quat (+ /mavros/imu/data)  →  /ekf_quat/ekf_odom  (full pose+velocity, ~470Hz)
       relay  →  /vins/imu_propagate  (consumed by YOPO / px4ctrl)

     The intermediate topic /far_vins/imu_propagate avoids a relay loop.
     Only one VIO should run at a time:
       VINS-Fusion:  roslaunch vins vins_d455i.launch
       far_vins:     roslaunch far_vins c5_vio.launch

     Calibration files:
       c5_d455.yaml  — D455 (当前默认; TODO: 完成 Kalibr 标定后更新内参和 T_B_C)
       c5_yopo.yaml  — D435i (原标定值, 保留备用)
       c5.yaml       — D435i FALCON 原版 848x480
-->
<launch>
  <!-- Default calibration: D455 (640x480).
       切换回 D435i: roslaunch far_vins c5_vio.launch calib_file:=$(find far_vins)/param/calib/c5_yopo.yaml -->
  <arg name="calib_file" default="$(find far_vins)/param/calib/c5_d455.yaml"/>

  <!-- VIO node: output to intermediate topic to avoid relay loop -->
  <node pkg="far_vins" type="FAR_vio" name="far_vins_node" clear_params="true" output="screen" args="--v=0">

    <remap from="~/far_imu_propagation" to="/far_vins/imu_propagate" />

    <!-- Camera topics (RealSense D455, 640x480 rectified infrared) -->
    <param name="cam0_topic" value="/camera/infra1/image_rect_raw" type="str" />
    <param name="cam1_topic" value="/camera/infra2/image_rect_raw" type="str" />

    <!-- IMU topic: data_raw matches the Kalibr calibration used for extrinsics -->
    <param name="imu_topic" value="/mavros/imu/data" type="str" />

    <!-- Camera-IMU calibration file -->
    <param name="calib_file" value="$(arg calib_file)" />

    <!-- Algorithm parameters -->
    <rosparam file="$(find far_vins)/param/vio_stereo.yaml" />
    <param name='runlc' value='false' />

  </node>

  <!-- EKF: fuse /mavros/imu/data (attitude) + far_vins position → full odometry -->
  <node pkg="ekf_quat" type="ekf_quat" name="ekf_quat" output="screen">
    <remap from="~imu"          to="/mavros/imu/data"/>
    <remap from="~bodyodometry" to="/far_vins/imu_propagate"/>
    <remap from="~ekf_odom"     to="/ekf_quat/ekf_odom"/>

    <rosparam file="$(find ekf_quat)/launch/PX4_vio_drone_mavros.yaml" command="load"/>

    <param name="offset_px" type="double" value="0.0"/>
    <param name="offset_py" type="double" value="0.0"/>
    <param name="offset_pz" type="double" value="0.0"/>

    <!-- IMU-to-body offset: 0 for VIO (no LiDAR z-offset needed) -->
    <param name="imu_trans_x" type="double" value="0.0"/>
    <param name="imu_trans_y" type="double" value="0.0"/>
    <param name="imu_trans_z" type="double" value="0.0"/>

    <param name="gyro_cov"     type="double" value="0.05"/>
    <param name="acc_cov"      type="double" value="0.60"/>
    <param name="position_cov" type="double" value="0.01"/>
    <param name="q_rp_cov"     type="double" value="0.01"/>
    <param name="q_yaw_cov"    type="double" value="0.01"/>
    <param name="cutoff_freq"  type="double" value="20"/>
  </node>

  <!-- Relay EKF output to the topic YOPO/px4ctrl expects -->
  <node pkg="topic_tools" type="relay" name="odom_relay" output="screen"
        args="/ekf_quat/ekf_odom /vins/imu_propagate"/>

</launch>
