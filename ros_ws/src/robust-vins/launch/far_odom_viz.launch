<launch>
    <node pkg="odom_visualization" name="odom_visualization" type="odom_visualization" output="screen">
        <remap from="~odom" to="/far_vins_node/optimization_pose"/>
        <!-- <remap from="~odom" to="/vins_node/imu_propagate"/> -->
        <!-- <remap from="~odom" to="/svo/optimization_pose"/> -->
         <!-- <remap from="~odom" to="/orb_slam3/body_odom"/> -->
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="1.0"/>
        <param name="color/g" value="0.0"/>
        <param name="color/b" value="0.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="4.0"/>
        <param name="tf45" value="true"/>
    </node>
</launch>