<launch>
  <arg name="launch_camera" default="true"/>
  <arg name="launch_mavros" default="true"/>
  <arg name="launch_vio" default="true"/>
  <arg name="launch_rviz" default="true"/>

  <arg name="camera" default="camera"/>
  <arg name="fcu_url" default="/dev/ttyTHS0:921600"/>
  <arg name="calib_file" default="$(find far_vins)/param/calib/zuanfeng.yaml"/>
  <arg name="enable_depth" default="false"/>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch" if="$(arg launch_camera)">
    <arg name="camera" value="$(arg camera)"/>
    <arg name="enable_depth" value="$(arg enable_depth)"/>
  </include>

  <include file="$(find mavros)/launch/px4.launch" if="$(arg launch_mavros)">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
  </include>

  <include file="$(find far_vins)/launch/zuanfeng_vio.launch" if="$(arg launch_vio)">
    <arg name="calib_file" value="$(arg calib_file)"/>
  </include>

  <include file="$(find far_vins)/launch/rviz.launch" if="$(arg launch_rviz)">
    <arg name="calib_file" value="$(arg calib_file)"/>
  </include>
</launch>
